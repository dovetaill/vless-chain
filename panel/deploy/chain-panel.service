[Unit]
Description=Chain Panel controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chain-panel
Group=chain-panel
StateDirectory=chain-panel
StateDirectoryMode=0700
UMask=0077
Environment=CHAIN_DATA_DIR=/var/lib/chain-panel
Environment=CHAIN_LISTEN=127.0.0.1:8088
Environment=CHAIN_XRAY_BIN=/opt/chain/bin/xray
Environment=CHAIN_SECURE_COOKIE=1
ExecStart=/opt/chain/bin/chain-panel
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
